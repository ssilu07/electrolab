{
  "name": "electrolab",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android:bundle": "npm run build && npx cap sync android && cd android && .\\gradlew.bat bundleRelease",
    "android:release": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleRelease",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@types/three": "^0.186.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
